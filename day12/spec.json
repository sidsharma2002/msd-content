{
 "day": 12,
 "topic": "Typing indicators and presence",
 "tag": "CHAT",
 "script": {
  "hook": "The typing indicator never goes away. Interviewers love this bug.",
  "question": "Design typing indicators and presence for a chat app.",
  "trap": "The trap: send an event on every keystroke. That floods the server, and one lost stop leaves typing stuck forever.",
  "steps": [
   "Throttle sends. Send typing once every three seconds while the user types. Send stop on send.",
   "Expire on receive. Show typing for five seconds, then hide it. A lost stop heals itself.",
   "Heartbeat presence. Ping every thirty seconds in the foreground. Sixty seconds of silence means offline.",
   "Scope the fan out. Send presence only to open chats and close contacts. Subscribe when a screen opens."
  ],
  "takeaway": "Throttle the sender, expire on the receiver, heartbeat for presence.",
  "teaser": "Tomorrow: read receipts and delivery status.",
  "cta": "Comment M S D for the free cheatsheet."
 },
