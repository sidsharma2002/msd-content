 "script": {
  "hook": "A user says no to tracking, and your app still sends their email.",
  "question": "Design consent and PII handling for mobile analytics.",
  "trap": "The trap: collect everything, filter on the server later. The data already left the device.",
  "steps": [
   "Gate at the source. Store consent on the device, and check it before any event is created.",
   "Minimize the payload. No emails, phone numbers or exact locations. Use an allowlist of fields.",
   "Pseudonymize the identity. Send a random id, and keep the mapping on the server, behind access control.",
   "Honor withdrawal. Stop collecting, clear the queue, and send a deletion request keyed by the id."
  ],
  "takeaway": "Gate at the source, allowlist fields, hash the identity, delete on withdrawal.",
  "teaser": "Tomorrow: the crash reporting pipeline.",
  "cta": "Comment M S D for the free cheatsheet."
 },
