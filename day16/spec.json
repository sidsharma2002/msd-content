  "script": {
    "hook": "One message to a group of five hundred. Who does the copying?",
    "question": "Design group chat fan-out that delivers one message to every member.",
    "trap": "The trap: the sender loops over members and writes one copy per person. That hammers the server on every send, slows big groups, and a retry sends duplicates.",
    "steps": [
      "Store once. Write the message to one group log with a sequence number. The sender makes one request, not five hundred.",
      "Small groups fan out on write. Each member gets a copy in their inbox, so reads are instant.",
      "Large groups fan out on read. Members pull the group log from their last cursor, so writes stay cheap.",
      "Wake the phones. Push only offline members, and collapse the rest into one notification per group."
    ],
    "takeaway": "Store the message once. Copy it only when the room is small, and read it when the room is large.",
    "teaser": "Tomorrow: End-to-end encryption on mobile.",
    "cta": "Comment write or read, and tell me why."
  },
